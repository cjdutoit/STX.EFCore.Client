<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>disable</Nullable>
		<NoWarn>CS1998</NoWarn>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<Title>STX.EFCore.Client</Title>
		<Authors>Christo du Toit</Authors>
		<Description>A general-purpose EF Core client for common data operations, designed for use in a Storage Broker.</Description>
		<Copyright>Copyright (c) Christo du Toit</Copyright>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
		<PackageIcon>Operations.png</PackageIcon>
		<Version>3.0.0</Version>
		<AssemblyVersion>3.0.0.0</AssemblyVersion>
		<FileVersion>3.0.0.0</FileVersion>
		<NeutralLanguage>en-US</NeutralLanguage>
		<PackageProjectUrl>https://github.com/cjdutoit/STX.EFCore.Client</PackageProjectUrl>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/cjdutoit/STX.EFCore.Client</RepositoryUrl>
		<RepositoryType>Github</RepositoryType>
		<PackageTags>EF;EFCore;EntityFramework;StorageBroker;BulkInsert;BulkUpdate;BulkDelete;BulkUpsert;Operations;CSharp</PackageTags>
		<PackageReleaseNotes>
			v3.0.0 — Targets .NET 10 and EF Core 10.
			Adds BulkUpsertAsync and ExistsAsync.
			Removes exception categorisation — raw EF Core exceptions now propagate directly to the caller.
			Null argument validation uses ArgumentNullException (standard .NET).
			This release contains breaking changes — see the README for migration guidance.
		</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="STX.EFCore.Client.Tests.Unit" />
		<InternalsVisibleTo Include="STX.EFCore.Client.Tests.Acceptance" />
		<InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="..\LICENSE.txt">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
			<Pack>True</Pack>
			<PackagePath></PackagePath>
		</Content>
		<Content Include="..\README.md">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
			<Pack>True</Pack>
			<PackagePath></PackagePath>
		</Content>
		<None Include="..\Resources\Operations.png">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
			<Pack>True</Pack>
			<PackagePath></PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.7" />
	</ItemGroup>

</Project>
